# Salin file ini jadi ".env" lalu isi nilainya sendiri. JANGAN commit ".env" ke Git.

# Lokasi file database SQLite (biarkan default kalau tidak tahu harus diapakan)
DATABASE_URL="file:./dev.db"

# Akun admin default — WAJIB diisi sebelum menjalankan `npx prisma db seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat-anda"

# String acak panjang untuk menandatangani session login (isi bebas, makin
# panjang & acak makin aman). Contoh cara generate cepat di terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
